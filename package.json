{
  "name": "xylem",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:c2": "playwright test --config playwright.c2.config.js",
    "test:staging": "playwright test --config playwright.staging.config.js",
    "test:staging-safety": "playwright test --config playwright.safety.config.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/structured-logger": "1.0.0",
    "@rgrove/parse-xml": "5.0.0",
    "hono": "^4.13.13",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "parse5": "8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "leaflet": "2.0.0-alpha.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild": false
  },
  "volta": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
